schema_version: dev-foundry.platform-bootstrap.v3
id: {{PREFIX}}-PLATFORM-BOOTSTRAP-CLAUDE-CODE
title: {{PROJECT}} Claude Code Platform Bootstrap
kind: platform-bootstrap
status: active
artifact_version: "claude-adapter-1"
canonical: false
methodology_authority: false

repository:
  expected_name: {{PROJECT}}
  workspace_binding: repository-root

sources:
  project_operating_profile: .dev-foundry/profiles/project-operating-profile.yaml
  authority_index: .dev-foundry/authority-index.yaml

actor_resolution:
  mode: governed-project-bindings
  eligible_profiles:
    - {{AUTHOR_PROFILE}}
    - {{CUSTODIAN_PROFILE}}
  fixed_profile: null
  default_role: governance-author
  rule: >
    Resolve exactly one eligible role/profile before each role-dependent bounded
    operation. The claude-main-agent is eligible only for Governance Author or
    Evidence Custodian through active POP bindings and operation-scoped role
    selection. Implementation Executor and Governance Auditor are dispatched
    explicitly to their dedicated project subagents after resolution. Mechanical
    Validator is separately bound to native Claude Code validation.

platform:
  id: claude-code
  startup_constraints:
    - start governed work from the {{PROJECT}} repository root
    - load project instruction files only as startup guidance, never as authority
    - retrieve the active POP and Authority Index before role-dependent work
    - use one scoped resolve_governed_operation call for current source-bound role and task authority
    - workspace trust and project MCP approval remain explicit Operator-side provider security mechanics
    - operation-specific implementation selection, capability fit, and authorization must be evidenced outside the POP role binding
    - repository identity, stale authority, and missing operation evidence fail closed

constraints:
  - active reusable methodology is sourced only from the POP-selected immutable canonical framework release
  - v3 POP role bindings contain policy and capability requirements, not concrete implementation identity
  - bootstrap platform identity describes startup only and grants no role or operation
  - capability does not grant authority
  - role selection is operation-scoped
  - conversational continuity does not transfer authority or satisfy independence
  - the Governance Author delegates implementation only with a current compact handoff and existing native permission checks
  - the Auditor is selected only when a named independent-review trigger applies and eligibility is evidenced
  - project instruction files and the project governance MCP are startup mechanisms and not repository authority
  - repository configuration must not bypass workspace trust or silently pre-approve the project MCP
